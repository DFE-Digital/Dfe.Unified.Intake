@page
@model IndexModel
@{
    ViewData["Title"] = "Tell us what you need";
}

<h1 class="govuk-heading-l">Tell us what you need</h1>

<form method="post">
    <govuk-select for="Service">
        <govuk-select-label class="govuk-label--s">Which service is your request for?</govuk-select-label>
        <govuk-select-item value="" selected="true">Choose a service</govuk-select-item>
        <govuk-select-item value="Complete">Complete Conversions and Transfers (Complete)</govuk-select-item>
        <govuk-select-item value="EAT">External Applications - Academy Transfers (EAT)</govuk-select-item>
        <govuk-select-item value="FAST">Find Information About Schools and Trusts (FAST)</govuk-select-item>
        <govuk-select-item value="MFSP">Manage New School Projects (MFSP)</govuk-select-item>
        <govuk-select-item value="MSI">Manage School Improvements (MSI)</govuk-select-item>
        <govuk-select-item value="Prepare">Prepare Conversions and Transfers (Prepare)</govuk-select-item>
        <govuk-select-item value="RECAST">Record Concerns and Support for Trusts (RECAST)</govuk-select-item>
        <govuk-select-item value="REEP">Record Engagement with Education Providers (REEP)</govuk-select-item>
        <govuk-select-item value="VCC">Vulnerable Children’s Casework (VCC)</govuk-select-item>
        <govuk-select-item value="SE">Something new</govuk-select-item>
    </govuk-select>

    <govuk-radios for="RequestType">
        <govuk-radios-fieldset>
            <govuk-radios-fieldset-legend class="govuk-fieldset__legend--s govuk-!-font-weight-bold">What is your request about?</govuk-radios-fieldset-legend>
            <govuk-radios-hint>Choose the option that best describes your request</govuk-radios-hint>
            <govuk-radios-item value="report-a-problem">
                Report a problem
                <govuk-radios-item-hint>Something isn't working as expected</govuk-radios-item-hint>
            </govuk-radios-item>
            <govuk-radios-item value="suggest-a-change">
                Suggest a change
                <govuk-radios-item-hint>An idea to improve a service or process</govuk-radios-item-hint>
            </govuk-radios-item>
            <govuk-radios-item value="raise-a-risk-or-compliance-concern">
                Raise a risk or compliance concern
                <govuk-radios-item-hint>Report concerns about legal or regulatory requirements</govuk-radios-item-hint>
            </govuk-radios-item>
            <govuk-radios-divider>or</govuk-radios-divider>
            <govuk-radios-item value="something-else">
                Something else
                <govuk-radios-item-hint>You're not sure which option to choose</govuk-radios-item-hint>
            </govuk-radios-item>
        </govuk-radios-fieldset>
    </govuk-radios>

    <govuk-button>Continue</govuk-button>
</form>
