@page
@using Dfe.Unified.Intake.Pages.Models
@using GovUk.Frontend.AspNetCore
@model IndexModel
@{
    ViewData["Title"] = "Which service is your request for?";
}

<form method="post">
    <govuk-checkboxes for="Services">
        <govuk-checkboxes-fieldset>
            <govuk-checkboxes-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">Which service is your request for?</govuk-checkboxes-fieldset-legend>
            <govuk-checkboxes-hint>Select one or more services that your request is for</govuk-checkboxes-hint>

            @foreach (var service in ServiceCatalogue.NamedServices)
            {
                <govuk-checkboxes-item value="@service.Code">@service.Label</govuk-checkboxes-item>
            }

            <govuk-checkboxes-divider>or</govuk-checkboxes-divider>
            <govuk-checkboxes-item value="@ServiceCatalogue.SomethingNew.Code" behavior="CheckboxesItemBehavior.Exclusive">
                @ServiceCatalogue.SomethingNew.Label
                <govuk-checkboxes-item-hint>@ServiceCatalogue.SomethingNew.Hint</govuk-checkboxes-item-hint>
            </govuk-checkboxes-item>
        </govuk-checkboxes-fieldset>
    </govuk-checkboxes>

    <govuk-button>Continue</govuk-button>
</form>
