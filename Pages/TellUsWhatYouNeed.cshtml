@page
@model TellUsWhatYouNeedModel
@{
    ViewData["Title"] = "Tell us what you need";
}

@section BeforeMain
{
    <a class="govuk-back-link" data-cy="select-backlink" asp-page="/Index">Back</a>
}

<h1 class="govuk-heading-l">Tell us what you need</h1>

<form method="post">
    <govuk-select for="Service">
        <govuk-select-label class="govuk-label--s">Which service is your request for?</govuk-select-label>
        <govuk-select-item value="" selected="true" disabled="true"></govuk-select-item>
        <govuk-select-item value="MSI">MSI – Manage School Improvements</govuk-select-item>
        <govuk-select-item value="Prepare">Prepare – Prepare Conversions and Transfers</govuk-select-item>
        <govuk-select-item value="Complete">Complete – Complete Conversions and Transfers</govuk-select-item>
        <govuk-select-item value="FAST">FAST – Find Information About Schools and Trusts</govuk-select-item>
        <govuk-select-item value="RECAST">RECAST – Record Concerns and Support for Trusts</govuk-select-item>
        <govuk-select-item value="MFSP">MFSP – Manage Free School Projects</govuk-select-item>
    </govuk-select>

    <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">What is your request about?</p>

    <govuk-radios for="RequestType">
        <govuk-radios-hint>Choose the option that best describes your request</govuk-radios-hint>
        <govuk-radios-item value="report-a-problem">
            Report a problem
            <govuk-radios-item-hint>Something isn't working as expected</govuk-radios-item-hint>
        </govuk-radios-item>
        <govuk-radios-item value="suggest-a-change">
            Suggest a change
            <govuk-radios-item-hint>An idea to improve a service or process</govuk-radios-item-hint>
        </govuk-radios-item>
        <govuk-radios-item value="raise-a-risk-or-compliance-concern">
            Raise a risk or compliance concern
            <govuk-radios-item-hint>Report concerns about legal or regulatory requirements</govuk-radios-item-hint>
        </govuk-radios-item>
        <govuk-radios-divider>or</govuk-radios-divider>
        <govuk-radios-item value="something-else">
            Something else
            <govuk-radios-item-hint>I'm not sure which option to choose</govuk-radios-item-hint>
        </govuk-radios-item>
    </govuk-radios>

    <govuk-button>Continue</govuk-button>
</form>
