@page
@model RequestSubmittedModel
@{
    ViewData["Title"] = "Request submitted";
}

<govuk-panel>
    <govuk-panel-title>Request submitted</govuk-panel-title>
    <govuk-panel-body>
        Your reference number<br />
        <strong>@Model.ReferenceNumber</strong>
    </govuk-panel-body>
</govuk-panel>

<p class="govuk-body govuk-!-margin-top-6">We have sent you a confirmation email.</p>
<p class="govuk-body">Include your reference number when contacting us about this request.</p>

<h2 class="govuk-heading-m">What happens next</h2>
<p class="govuk-body">We will:</p>
<ul class="govuk-list govuk-list--bullet">
    <li>review your request</li>
    <li>route it to the appropriate team</li>
    <li>contact you if we need more information</li>
    <li>keep a record of the outcome</li>
</ul>

<h2 class="govuk-heading-m">If you have suggested an improvement</h2>
<p class="govuk-body">We review all requests. Submitting a request does not guarantee the change will be made.</p>
<p class="govuk-body">Suggestions are considered alongside user needs, priorities, delivery capacity and strategic objectives.</p>

<form method="post">
    <govuk-button>Start a new request</govuk-button>
</form>
